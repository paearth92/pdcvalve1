# Use an isolated PDC Supabase project for each environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for portal invitation activation and document uploads.
SUPABASE_SECRET_KEY=

# Canonical origin for Auth email links and invitation activation.
# For local Supabase QA, use http://localhost:3100.
PORTAL_SITE_URL=
# At least 32 random characters. Signs the short-lived recovery state.
PORTAL_SESSION_SECRET=
# Enable only after configuring approved SMTP and verifying Auth templates.
PORTAL_EMAIL_ENABLED=false
